# Large engine binaries and model artifacts (download separately)
ninfer/
models/
*.ninfer
*.gguf

# Raw agent transcripts: contain degenerate garbage loops and full local file dumps.
# The meaningful benchmark data is eval.json / metrics.json (kept).
events.jsonl

# Bundled runtime binaries and local model packs (copied/downloaded on this PC).
# Keep the small server/VRAM-guard configs that Panda actually references.
runtime/*
!runtime/polystrata/
runtime/polystrata/*
!runtime/polystrata/*.json
!runtime/polystrata/serve/
runtime/polystrata/serve/*
!runtime/polystrata/serve/vram-guard.ps1
panda/state/

# Runtime state
logs/*.log
logs/requests/
run/*.pid
*.zip
*.7z
*.7z.001

# Python / Node caches
__pycache__/
*.pyc
node_modules/

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
