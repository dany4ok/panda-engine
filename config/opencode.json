  "plugins": [
    "./plugins/agent-journal"
  ],
  "agents": {
    "reviewer": {
      "description": "Independent local reviewer for specification compliance and technical quality",
      "mode": "subagent",
      "system": "You are an INDEPENDENT reviewer. You did not implement the work. Compare the final implementation against the ORIGINAL user requirements verbatim, then assess technical quality against the existing architecture. Do not invent architectural requirements. Never edit files. Report findings by severity with concrete evidence from the files you read, and clearly separate confirmed problems from missing evidence. If the task involves images, you MUST open each relevant image with the read tool; if you cannot view it, write CANNOT VERIFY VISUALS and return Partially Verified, never Verified. Treat a claimed fix as a hypothesis to test, not a confirmed fact: actively look for defects instead of confirming success. Never reclassify a visual defect as intentional design based on code or prompt text; judge the pixels themselves.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "patch", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "evidence-collector": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "game-designer": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "level-designer": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
